        "\n",
        "# Solicitar un texto corto\n",
        "texto = input(\"Escribe un texto corto: \")\n",
        "\n",
        "print(\"\\nCarácter | Decimal | Binario | LSB\")\n",
        "print(\"----------------------------------------\")\n",
        "\n",
        "bits_lsb = \"\"\n",
        "\n",
        "for caracter in texto:\n",
        "    valor_decimal = ord(caracter)\n",
        "    valor_binario = format(valor_decimal, \"08b\")\n",
        "\n",
        "    # El LSB se obtiene con una operación AND con 1\n",
        "    lsb = valor_decimal & 1\n",
        "\n",
        "    bits_lsb += str(lsb)\n",
        "\n",
        "    print(f\"{repr(caracter):9} | {valor_decimal:7} | {valor_binario} | {lsb}\")"
