      "cell_type": "code",
      "source": [
        "!pip install paho-mqtt\n",
        "\n",
        "import paho.mqtt.client as mqtt\n",
        "import time\n",
        "\n",
        "def on_connect(client, userdata, flags, rc, properties=None):\n",
        "    print(f\"Conectado con código de resultado: {rc}\")\n",
        "\n",
        "    # Suscribirse al tema después de la conexión exitosa\n",
        "    client.subscribe(\"casa/sala/temperatura\")\n",
        "\n",
        "\n",
        "def on_message(client, userdata, msg):\n",
        "    print(f\"Mensaje recibido en el tema '{msg.topic}': {msg.payload.decode()}\")\n",
        "\n",
        "\n",
        "subscriber_client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)\n",
        "\n",
        "subscriber_client.on_connect = on_connect\n",
        "subscriber_client.on_message = on_message\n",
        "\n",
        "# Conectar al mismo broker\n",
        "subscriber_client.connect(\"broker.hivemq.com\", 1883, 60)\n",
        "\n",
        "# Bucle en segundo plano para procesar mensajes\n",
        "subscriber_client.loop_start()\n",
        "\n",
        "print(\"Cliente suscriptor iniciado. Esperando mensajes...\")\n",
        "\n",
        "# Mantener el script en ejecución para recibir mensajes por un tiempo limitado\n",
        "timeout_seconds = 10\n",
        "start_time = time.time()\n",
        "\n",
        "try:\n",
        "    while (time.time() - start_time) < timeout_seconds:\n",
        "        time.sleep(1)\n",
        "\n",
        "    print(f\"\\nSuscriptor detenido automáticamente después de {timeout_seconds} segundos.\")\n",
        "\n",
        "except KeyboardInterrupt:\n",
        "    print(\"\\nSuscriptor detenido manualmente.\")\n",
        "\n",
        "finally:\n",
        "    subscriber_client.loop_stop()\n",
        "    subscriber_client.disconnect()"
      ],
